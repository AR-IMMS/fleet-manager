# Fleet uses the existing Docker MongoDB instance through its published port.
# Adjust 27017 if Docker publishes a different host port.
FLEET_MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
FLEET_MONGODB_DATABASE=ar_imms_fleet
FLEET_MONGODB_CONNECT_TIMEOUT=5s
FLEET_MONGODB_OPERATION_TIMEOUT=5s
FLEET_MONGODB_APP_NAME=ar-imms-fleet-manager
FLEET_SHUTDOWN_TIMEOUT=10s

# Fleet REST and health listener.
FLEET_HTTP_LISTEN_ADDRESS=127.0.0.1:8081
FLEET_HTTP_TLS_CERT_FILE=
FLEET_HTTP_TLS_KEY_FILE=
FLEET_HTTP_CLIENT_CA_FILE=
FLEET_API_DOCS_ENABLED=false
FLEET_HTTP_READ_HEADER_TIMEOUT=5s
FLEET_HTTP_READ_TIMEOUT=10s
FLEET_HTTP_WRITE_TIMEOUT=10s
FLEET_HTTP_IDLE_TIMEOUT=60s
FLEET_HTTP_READINESS_TIMEOUT=2s
FLEET_ENROLLMENT_ENABLED=false
FLEET_ENROLLMENT_ENCRYPTION_KEY=
FLEET_ENROLLMENT_DEFAULT_INVITATION_TTL=30m
FLEET_ENROLLMENT_MAXIMUM_INVITATION_TTL=24h
FLEET_ENROLLMENT_RECOVERY_TTL=24h
FLEET_ENROLLMENT_OPAMP_ENDPOINT=
FLEET_ENROLLMENT_CORE_CLIENT_CN=

# Native OpAMP listener. Plaintext is restricted to explicit loopback IPs.
OPAMP_ENABLED=false
OPAMP_LISTEN_ADDRESS=127.0.0.1:4320
OPAMP_PATH=/v1/opamp
OPAMP_MAX_MESSAGE_BYTES=1048576
OPAMP_AUTH_TIMEOUT=5s
# OPAMP_SHUTDOWN_TIMEOUT=10s

# Logging configuration.
FLEET_LOG_LEVEL=info
FLEET_LOG_FORMAT=text
FLEET_LOG_SERVICE=fleet-manager

# Configure both when enabling TLS.
# OPAMP_TLS_CERT_FILE=/path/to/server.crt
# OPAMP_TLS_KEY_FILE=/path/to/server.key
